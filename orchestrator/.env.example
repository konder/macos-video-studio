# 复制为 .env(或直接 export)。M1 必须在能访问 5090 的内网运行。
# Agent 经 LiteLLM 网关(OpenAI 兼容)调用,底层模型可自由替换;
# 配置走 orchestrator 专属变量,不碰全局 ANTHROPIC_*（不影响同机 Claude Code）。
LITELLM_BASE_URL=http://10.10.10.5:4000   # LiteLLM 网关
LITELLM_API_KEY=sk-...                     # LiteLLM key
AGENT_MODEL=                               # 要用的模型名(见 `python -m scripts.run_m1 --list-models`)
COMFY_URL=http://10.10.10.2:8188           # 5090 上的 ComfyUI
PROJECTS_DIR=./projects                    # 项目文件夹根(生产环境指向 NAS /mnt/nas)
