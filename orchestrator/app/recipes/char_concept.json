{
  "id": "char_concept",
  "title": "人物定稿（文生图）",
  "stage": "asset",
  "_note": "占位模板：核心节点 txt2img 结构示例。【M1 第一步】请在 ComfyUI UI 用 5090 实装基模（Z-Image Turbo / Flux-2 Klein）手搭一张能出图的图，导出 API 格式（prompt json）覆盖本文件的 graph_template，并据 /object_info 调整 class_type 与 inputs（Flux/Z-Image 的 loader 与 KSampler/EmptyLatent 与 SDXL 不同）。validate 会对照真实 /object_info 报错，照着改即可。",
  "backends": ["local"],
  "params_schema": {
    "prompt": {"type": "string"},
    "negative": {"type": "string", "default": ""},
    "width": {"type": "integer", "default": 1024},
    "height": {"type": "integer", "default": 1024},
    "steps": {"type": "integer", "default": 25},
    "cfg": {"type": "number", "default": 7.0},
    "seed": {"type": "integer", "default": 0},
    "ckpt_name": {"type": "string", "default": "REPLACE_WITH_REAL_MODEL.safetensors"}
  },
  "graph_template": {
    "nodes": {
      "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "{{ckpt_name}}"}, "pos": [40, 40]},
      "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["4", 1]}, "pos": [300, 40]},
      "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative}}", "clip": ["4", 1]}, "pos": [300, 240]},
      "5": {"class_type": "EmptyLatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}, "pos": [300, 440]},
      "3": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}, "pos": [600, 40]},
      "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}, "pos": [860, 40]},
      "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "reelforge"}, "pos": [1080, 40]}
    }
  }
}
