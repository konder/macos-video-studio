{
  "id": "char_concept",
  "title": "人物定稿（文生图 · Z-Image Turbo）",
  "stage": "asset",
  "_note": "文生图人物定稿。基模 Z-Image Turbo（5090 实装，见 docs/env-survey.md），8 步快出，1024² 默认。已在 ComfyUI UI 手搭验证可出图：UNETLoader→ModelSamplingAuraFlow(shift=3)→KSampler(res_multistep/simple,cfg=1,8步)；文本编码 CLIPLoader(qwen_3_4b,type=lumina2)；EmptySD3LatentImage(16ch)配 ae.safetensors。坑：勿用 WAN VAE(48ch)。Turbo 无负面词，用 ConditioningZeroOut 生成空负面条件。",
  "backends": ["local"],
  "params_schema": {
    "prompt": {"type": "string"},
    "width": {"type": "integer", "default": 1024},
    "height": {"type": "integer", "default": 1024},
    "steps": {"type": "integer", "default": 8},
    "cfg": {"type": "number", "default": 1.0},
    "seed": {"type": "integer", "default": 42}
  },
  "graph_template": {
    "nodes": {
      "28": {"class_type": "UNETLoader", "inputs": {"unet_name": "z_image_turbo_bf16.safetensors", "weight_dtype": "default"}, "pos": [40, 40]},
      "30": {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen_3_4b_fp8_mixed.safetensors", "type": "lumina2", "device": "default"}, "pos": [40, 220]},
      "29": {"class_type": "VAELoader", "inputs": {"vae_name": "ae.safetensors"}, "pos": [40, 440]},
      "27": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["30", 0]}, "pos": [340, 40]},
      "33": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["27", 0]}, "pos": [340, 320]},
      "13": {"class_type": "EmptySD3LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}, "pos": [340, 480]},
      "11": {"class_type": "ModelSamplingAuraFlow", "inputs": {"model": ["28", 0], "shift": 3.0}, "pos": [640, 40]},
      "3": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "res_multistep", "scheduler": "simple", "denoise": 1.0, "model": ["11", 0], "positive": ["27", 0], "negative": ["33", 0], "latent_image": ["13", 0]}, "pos": [640, 200]},
      "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["29", 0]}, "pos": [960, 40]},
      "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "char_concept"}, "pos": [1180, 40]}
    }
  }
}
